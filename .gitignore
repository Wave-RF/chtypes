# chtypes SDK — the four bindings, the header, the spec, the playgrounds.
# Artifacts are never here: they live in the per-user cache
# (~/.cache/chtypes/artifacts/abi<R>/<os>-<arch>, R the SDK's ABI revision)
# or wherever CHTYPES_REGISTRY says.

# Go
**/*.test
examples/go/playground
examples/go/ingest-demo/ingest-demo
# `go build ./...` from scripts/fetch-v1/genfixtures writes a binary named
# after the directory (it's a package main) — never checked in.
scripts/fetch-v1/genfixtures/genfixtures

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/

# TypeScript
node_modules/
ts/dist/

# Rust
target/

# Incidental
.DS_Store
*.log
scratch/

# Lint tooling — pinned binaries fetched by scripts/lint-*.sh (misspell,
# shellcheck, actionlint), never checked in.
.bin/
