{
  "name": "@wavehouse/chtypes",
  "version": "0.1.1",
  "description": "ClickHouse's own type system, per version, over the frozen chs_* C ABI",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "chtypes": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:bun": "for f in test/*.test.ts; do bun test \"$f\" || exit 1; done"
  },
  "dependencies": {
    "ffi-rs": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wave-RF/chtypes",
    "directory": "ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "clickhouse",
    "types",
    "schema",
    "validation",
    "ffi"
  ],
  "homepage": "https://github.com/wave-rf/chtypes/tree/main/ts#readme",
  "bugs": {
    "url": "https://github.com/wave-rf/chtypes/issues"
  }
}
